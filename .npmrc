# Pterodactyl/Wispbyte menjalankan `npm install` polos (tanpa flag).
# Dependency tree repo ini (banyak peerDependency better-auth) hanya
# terpasang bersih kalau peer dipaksa dan devDependency dilewati.
# omit=dev  -> jangan tarik @better-auth/cli (prisma/drizzle/better-call) yang bikin ERESOLVE + berat/OOM
# force=true -> tetap install peer dependency (mis. @better-auth/core) walau ada konflik versi
omit=dev
force=true
audit=false
fund=false
